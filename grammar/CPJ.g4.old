grammar CPJ;// ANTLR4 grammar for CPJ language// ANTLR4 grammar for CPJ language



program: (statement | NEWLINE)* EOF;// Supports mixed Python, C++, and Java syntax styles// Supports mixed Python, C++, and Java syntax styles



statement

    : guiBlock

    | funcDefgrammar CPJ;grammar CPJ;

    | typeDef

    | eventHandler

    | exprStmt SEMICOLON?

    | cppStyleBlock//// Parser rules

    ;

// Parser Rulesprogram

typeDef: TYPE_KW Identifier LBRACE typeFieldList RBRACE NEWLINE*;

typeFieldList: typeField (COMMA typeField)* (COMMA)?;//    : (statement | NEWLINE)* EOF

typeField: Identifier COLON typeRef;

    ;

typeRef

    : Identifier// Program structure

    | Identifier LBRACKET typeRef RBRACKET

    | VOIDprogram : (statement | NEWLINE)* EOF ;statement

    ;

    : guiBlock

funcDef: (PUBLIC? STATIC?)? DEF Identifier LPAREN paramList? RPAREN (ARROW typeRef)? (COLON (NEWLINE suite | suite) | cppStyleBlock);

paramList: param (COMMA param)*;statement    | funcDef

param: Identifier (COLON typeRef)?;

    : guiBlock    | typeDef

suite: INDENT NEWLINE* statement+ DEDENT | simpleStmt;

simpleStmt: exprStmt;    | funcDef    | eventHandler

cppStyleBlock: LBRACE NEWLINE* (statement SEMICOLON? NEWLINE?)* RBRACE NEWLINE?;

    | typeDef    | exprStmt SEMICOLON?

exprStmt: expression NEWLINE?;

    | eventHandler    | cppStyleBlock

expression

    : literal    | exprStmt SEMICOLON?    ;

    | Identifier

    | arrayExpr    | cppStyleBlock

    | NEW typeRef LPAREN exprList? RPAREN

    | expression LBRACKET expression RBRACKET    ;// Event handler definition

    | expression DOT Identifier

    | expression LPAREN exprList? RPARENeventHandler

    | expression op=(MUL | DIV) expression

    | expression op=(PLUS | MINUS) expression// Type system    : ON eventName=Identifier (FROM source=Identifier)? DO COLON NEWLINE suite

    | expression ASSIGN expression

    | expression op=(EQ | NEQ) expressiontypeDef : TYPE_KW Identifier LBRACE typeFieldList RBRACE NEWLINE* ;    ;

    | expression op=(LT | GT | LE | GE) expression

    | LPAREN expression RPARENtypeFieldList : typeField (COMMA typeField)* (COMMA)? ;

    ;

typeField : Identifier COLON typeRef ;// User-defined type declaration

arrayExpr: LBRACKET (expression (COMMA expression)*)? RBRACKET;

exprList: expression (COMMA expression)*;typeReftypeDef



eventHandler: ON eventName=Identifier (FROM source=Identifier)? DO COLON NEWLINE suite;    : Identifier                            // Simple type    : TYPE_KW Identifier LBRACE typeFieldList RBRACE NEWLINE*



guiBlock    | Identifier LBRACKET typeRef RBRACKET  // Array/List type    ;

    : GUI_KW Identifier COLON NEWLINE INDENT (guiBody | eventHandler)+ DEDENT

    | GUI_CAP LBRACE NEWLINE* INDENT (guiBody | eventHandler)+ DEDENT RBRACE NEWLINE*    | VOID                                  // Void type

    ;

    ;typeFieldList

guiBody

    : typesLine    : typeField (COMMA typeField)* (COMMA)?

    | widgetStmt

    | callStmt// Functions and Methods    ;

    | guiProp

    | expression (NEWLINE)?funcDef

    | NEWLINE+

    ;    : (PUBLIC? STATIC?)? DEF Identifier LPAREN paramList? RPAREN typeField



guiProp: Identifier COLON expression NEWLINE;      (ARROW typeRef)?     : Identifier COLON Identifier

typesLine: TYPES_KW (typesTokens | typesDict);

typesTokens: (Identifier COLON Identifier | Identifier ASSIGN Identifier)+ NEWLINE;      (COLON (NEWLINE suite | suite) | cppStyleBlock)    ;

typesDict: LBRACE (typeEntries RBRACE NEWLINE | NEWLINE INDENT NEWLINE* typeLine+ DEDENT RBRACE NEWLINE);

typeEntries: typeEntry (COMMA typeEntry)* (COMMA)?;    ;

typeLine: typeEntry (COMMA)? NEWLINE;

typeEntry: (StringLiteral | Identifier) COLON (StringLiteral | Identifier);paramList : param (COMMA param)* ;



widgetStmtparam : Identifier (COLON typeRef)? ;// Function definition with optional type annotations and return type

    : ADD_TEXT LPAREN exprList? RPAREN

    | ADD_BTN LPAREN exprList? RPARENfuncDef

    | ADD_CHECK LPAREN exprList? RPAREN

    | ADD_SLIDER LPAREN exprList? RPAREN// Code blocks    : (PUBLIC? STATIC?)? DEF Identifier LPAREN paramList? RPAREN (ARROW typeRef)? (COLON (NEWLINE suite | suite) | cppStyleBlock)

    ;

suite : INDENT NEWLINE* statement+ DEDENT | simpleStmt ;    ;

callStmt: Identifier (DOT Identifier)* LPAREN exprList? RPAREN (NEWLINE | INDENT | DEDENT)?;

simpleStmt : exprStmt ;

literal

    : IntegerLiteralcppStyleBlock : LBRACE NEWLINE* (statement SEMICOLON? NEWLINE?)* RBRACE NEWLINE? ;typeRef

    | FloatLiteral

    | StringLiteral    : Identifier                           // Simple type

    | BooleanLiteral

    | NULL// Expressions    | Identifier LBRACKET typeRef RBRACKET  // Array/List type

    ;

exprStmt : expression NEWLINE? ;    | VOID                                  // Void type

TYPE_KW: [tT][yY][pP][eE];

DEF: [dD][eE][fF];expression    ;

PUBLIC: [pP][uU][bB][lL][iI][cC];

STATIC: [sS][tT][aA][tT][iI][cC];    : literal                                  // Literal values

NEW: [nN][eE][wW];

VOID: [vV][oO][iI][dD];    | Identifier                              // Variable referenceparamList

NULL: [nN][uU][lL][lL];

ON: [oO][nN];    | arrayExpr                               // Array literal    : param (COMMA param)*

FROM: [fF][rR][oO][mM];

DO: [dD][oO];    | NEW typeRef LPAREN exprList? RPAREN     // Object creation    ;

GUI_KW: [gG][uU][iI];

GUI_CAP: 'GUI';    | expression LBRACKET expression RBRACKET  // Array access

TYPES_KW: [tT][yY][pP][eE][sS];

    | expression DOT Identifier               // Member accessparam

ARROW: '->';

ASSIGN: '=';    | expression LPAREN exprList? RPAREN      // Function call    : Identifier (COLON Identifier)?

EQ: '==';

NEQ: '!=';    | expression op=(MUL | DIV) expression    // Multiplicative    ;

LT: '<';

GT: '>';    | expression op=(PLUS | MINUS) expression // Additive// New lexer tokens for type system

LE: '<=';

GE: '>=';    | expression ASSIGN expression            // Assignment// Keywords

PLUS: '+';

MINUS: '-';    | expression op=(EQ | NEQ) expression     // EqualityTYPE_KW: [tT][yY][pP][eE] ;

MUL: '*';

DIV: '/';    | expression op=(LT | GT | LE | GE) expression  // ComparisonARROW: '->' ;

DOT: '.';

    | LPAREN expression RPAREN                // GroupingON: [oO][nN] ;

LPAREN: '(';

RPAREN: ')';    ;FROM: [fF][rR][oO][mM] ;

LBRACE: '{';

RBRACE: '}';DO: [dD][oO] ;

LBRACKET: '[';

RBRACKET: ']';arrayExpr : LBRACKET (expression (COMMA expression)*)? RBRACKET ;PUBLIC: [pP][uU][bB][lL][iI][cC] ;

SEMICOLON: ';';

COLON: ':';exprList : expression (COMMA expression)* ;STATIC: [sS][tT][aA][tT][iI][cC] ;

COMMA: ',';

NEW: [nN][eE][wW] ;

IntegerLiteral: Digit+;

FloatLiteral: Digit+ '.' Digit* | '.' Digit+;// Event systemVOID: [vV][oO][iI][dD] ;

StringLiteral: '"' (~["\r\n])* '"' | '\'' (~['\r\n])* '\'';

BooleanLiteral: 'true' | 'false';eventHandler : ON eventName=Identifier (FROM source=Identifier)? DO COLON NEWLINE suite ;



NEWLINE: ('\r'? '\n')+;// Operators and punctuation

INDENT: 'INDENT';

DEDENT: 'DEDENT';// GUI systemSEMICOLON: ';' ;

WS: [ \t]+ -> skip;

COMMENT: '//' ~[\r\n]* -> skip;guiBlockLBRACKET: '[' ;



ADD_TEXT: 'addTextField';    : GUI_KW Identifier COLON NEWLINE INDENT (guiBody | eventHandler)+ DEDENTRBRACKET: ']' ;

ADD_BTN: 'addButton';

ADD_CHECK: 'addCheckbox';    | GUI_CAP LBRACE NEWLINE* INDENT (guiBody | eventHandler)+ DEDENT RBRACE NEWLINE*

ADD_SLIDER: 'addSlider';

    ;suite

fragment Digit: [0-9];

fragment Letter: [a-zA-Z_];    : INDENT NEWLINE* statement+ DEDENT



Identifier: Letter (Letter | Digit)*;guiBody    | simpleStmt

    : typesLine    ;

    | widgetStmt

    | callStmtsimpleStmt

    | guiProp    : exprStmt

    | expression (NEWLINE)?    ;

    | NEWLINE+

    ;exprStmt

    : expression NEWLINE?

guiProp : Identifier COLON expression NEWLINE ;    ;

typesLine : TYPES_KW (typesTokens | typesDict) ;

typesTokens : (Identifier COLON Identifier | Identifier ASSIGN Identifier)+ NEWLINE ;cppStyleBlock

    : LBRACE NEWLINE* (statement SEMICOLON? NEWLINE?)* RBRACE NEWLINE?

typesDict    ;

    : LBRACE (typeEntries RBRACE NEWLINE 

    | NEWLINE INDENT NEWLINE* typeLine+ DEDENT RBRACE NEWLINE)expression

    ;    : literal                                  // Literal values

    | Identifier                              // Variable reference

typeEntries : typeEntry (COMMA typeEntry)* (COMMA)? ;    | arrayExpr                               // Array literal

typeLine : typeEntry (COMMA)? NEWLINE ;    | expression LBRACKET expression RBRACKET  // Array access

typeEntry : (StringLiteral | Identifier) COLON (StringLiteral | Identifier) ;    | NEW typeRef LPAREN exprList? RPAREN     // Object creation

    | expression DOT Identifier               // Member access

// Widget system    | expression LPAREN exprList? RPAREN      // Function call

widgetStmt    | expression (MUL | DIV) expression       // Multiplicative

    : ADD_TEXT LPAREN exprList? RPAREN    | expression (PLUS | MINUS) expression    // Additive

    | ADD_BTN LPAREN exprList? RPAREN    | expression ASSIGN expression            // Assignment

    | ADD_CHECK LPAREN exprList? RPAREN    ;

    | ADD_SLIDER LPAREN exprList? RPAREN

    ;exprList

    : expression (COMMA expression)*

callStmt : Identifier (DOT Identifier)* LPAREN exprList? RPAREN (NEWLINE | INDENT | DEDENT)? ;    ;



// Basic elementsexprList

literal    : expression (COMMA expression)*

    : IntegerLiteral    ;

    | FloatLiteral

    | StringLiteralarrayExpr

    | BooleanLiteral    : LBRACKET (expression (COMMA expression)*)? RBRACKET

    | NULL    ;

    ;

// GUI block

//guiBlock

// Lexer Rules    : GUI_KW Identifier COLON NEWLINE INDENT (guiBody | eventHandler)+ DEDENT

//    | GUI_CAP LBRACE NEWLINE* INDENT (guiBody | eventHandler)+ DEDENT RBRACE NEWLINE*

    ;

// Keywords

TYPE_KW: [tT][yY][pP][eE] ;guiBody

DEF: [dD][eE][fF] ;    : typesLine

PUBLIC: [pP][uU][bB][lL][iI][cC] ;    | widgetStmt

STATIC: [sS][tT][aA][tT][iI][cC] ;    | callStmt

NEW: [nN][eE][wW] ;    | guiProp

VOID: [vV][oO][iI][dD] ;    | expression (NEWLINE)?

NULL: [nN][uU][lL][lL] ;    | NEWLINE+

ON: [oO][nN] ;    ;

FROM: [fF][rR][oO][mM] ;

DO: [dD][oO] ;guiProp

GUI_KW: [gG][uU][iI] ;    : Identifier COLON expression NEWLINE

GUI_CAP: 'GUI' ;    ;

TYPES_KW: [tT][yY][pP][eE][sS] ;

// types support: token-style or dict-style

// OperatorstypesLine

ARROW: '->' ;    : TYPES_KW (typesTokens | typesDict)

ASSIGN: '=' ;    ;

EQ: '==' ;

NEQ: '!=' ;// token-style: one or more key:type pairs on the same line

LT: '<' ;typesTokens

GT: '>' ;    : (Identifier COLON Identifier | Identifier '=' Identifier)+ NEWLINE

LE: '<=' ;    ;

GE: '>=' ;

PLUS: '+' ;// dict-style: allow either inline {"x":"int",...} or block style with INDENT/DEDENT

MINUS: '-' ;typesDict

MUL: '*' ;    : LBRACE (typeEntries RBRACE NEWLINE | NEWLINE INDENT NEWLINE* typeLine+ DEDENT RBRACE NEWLINE)

DIV: '/' ;    ;

DOT: '.' ;

typeEntries

// Punctuation    : typeEntry (',' typeEntry)* (',')?

LPAREN: '(' ;    ;

RPAREN: ')' ;

LBRACE: '{' ;typeLine

RBRACE: '}' ;    : typeEntry (',')? NEWLINE

LBRACKET: '[' ;    ;

RBRACKET: ']' ;

SEMICOLON: ';' ;// allow Identifier or StringLiteral for keys and for type names

COLON: ':' ;typeEntry

COMMA: ',' ;    : (StringLiteral | Identifier) COLON (StringLiteral | Identifier)

    ;

// Literals

IntegerLiteral: Digit+ ;// Widget statements (a subset)

FloatLiteral: Digit+ '.' Digit* | '.' Digit+ ;widgetStmt

StringLiteral: '"' (~["\r\n])* '"' | '\'' (~['\r\n])* '\'' ;    : ADD_TEXT LPAREN args? RPAREN

BooleanLiteral: 'true' | 'false' ;    | ADD_BTN LPAREN args? RPAREN

    | ADD_CHECK LPAREN args? RPAREN

// Whitespace and comments    | ADD_SLIDER LPAREN args? RPAREN

NEWLINE: ('\r'? '\n')+ ;    ;

INDENT: 'INDENT' ;  // Added by preprocessor

DEDENT: 'DEDENT' ;  // Added by preprocessorargs

WS: [ \t]+ -> skip ;    : arg (',' arg)*

COMMENT: '//' ~[\r\n]* -> skip ;    ;



// Widget namesarg

ADD_TEXT: 'addTextField' ;    : StringLiteral

ADD_BTN: 'addButton' ;    | expression

ADD_CHECK: 'addCheckbox' ;    ;

ADD_SLIDER: 'addSlider' ;

// expression variant without requiring trailing NEWLINE — used inside GUI bodies

// FragmentsexprNoNewline

fragment Digit: [0-9] ;    : expression

fragment Letter: [a-zA-Z_] ;    ;



// Identifiers (must be last to avoid conflicting with keywords)// Expressions (basic, with dotted identifiers and function calls)

Identifier: Letter (Letter | Digit)* ;expression
    : lambdaExpr
    ;
lambdaExpr
    : logicalOr
    ;

logicalOr
    : logicalAnd ('or' logicalAnd)*
    ;

logicalAnd
    : equality ('and' equality)*
    ;

equality
    : comparison ((EQ | NEQ) comparison)*
    ;

comparison
    : bitwiseOr ((LT | GT | LE | GE | IN | IS) bitwiseOr)*
    ;

bitwiseOr
    : bitwiseXor (BITOR bitwiseXor)*
    ;

bitwiseXor
    : bitwiseAnd (BITXOR bitwiseAnd)*
    ;

bitwiseAnd
    : shift (BITAND shift)*
    ;

shift
    : sum ((LSHIFT | RSHIFT) sum)*
    ;

sum
    : term ((PLUS | MINUS) term)*
    ;

term
    : factor ((STAR | DIV | MOD) factor)*
    ;

factor
    : (PLUS | MINUS | TILDE) factor
    | power
    ;

power
    : atom (POW factor)?
    ;

atom
    : LPAREN expression RPAREN
    | literal
    | dottedName ( LPAREN argList? RPAREN )?
    ;

argList
    : expression (',' expression)*
    ;

// Bare function-call statement (e.g. show()) used inside GUI bodies
callStmt
    : dottedName '(' argList? ')' (NEWLINE | INDENT | DEDENT)?
    ;


dottedName
    : Identifier (DOT Identifier)*
    ;

literal
    : Integer
    | Float
    | StringLiteral
    | TRUE | FALSE | NULL
    ;

// Lexer rules

// Structural tokens
NEWLINE: ('\r'? '\n')+ ;
INDENT: '<INDENT>' ;
DEDENT: '<DEDENT>' ;

// Punctuation and operators (named tokens to avoid ambiguous implicit numbering)
LPAREN: '(' ;
RPAREN: ')' ;
COLON: ':' ;
COMMA: ',' ;
LBRACE: '{' ;
RBRACE: '}' ;
DOT: '.' ;

PLUS: '+' ;
MINUS: '-' ;
STAR: '*' ;
DIV: '/' ;
MOD: '%' ;
POW: '**' ;
TILDE: '~' ;

LT: '<' ;
GT: '>' ;
LE: '<=' ;
GE: '>=' ;
EQ: '==' ;
NEQ: '!=' ;
LSHIFT: '<<' ;
RSHIFT: '>>' ;
BITOR: '|' ;
BITXOR: '^' ;
BITAND: '&' ;

// Keywords and widget names
// Keywords (case-insensitive where appropriate). Widget function names are case-sensitive.
DEF: [dD][eE][fF] ;
GUI_CAP: 'GUI' ;
GUI_KW: [gG][uU][iI] ;
TYPES_KW: [tT][yY][pP][eE][sS] ;
ADD_TEXT: 'addTextField' ;
ADD_BTN: 'addButton' ;
ADD_CHECK: 'addCheckBox' ;
ADD_SLIDER: 'addSlider' ;
OR: [oO][rR] ;
AND: [aA][nN][dD] ;
IN: [iI][nN] ;
IS: [iI][sS] ;
TRUE: [tT][rR][uU][eE] ;
FALSE: [fF][aA][lL][sS][eE] ;
NULL: [nN][uU][lL][lL] ;

// Numeric literals: Float must come before Integer so multi-part numbers are matched first.
fragment DIGIT: [0-9] ;
fragment DIGITS: DIGIT+ ;

Float
    : DIGITS '.' DIGITS? ([eE] [+-]? DIGITS)?
    | '.' DIGITS ([eE] [+-]? DIGITS)?
    | DIGITS [eE] [+-]? DIGITS
    ;

Integer: DIGITS ;
StringLiteral
    : '"' (~["\\] | '\\' .)* '"'
    | '\'' (~['\\] | '\\' .)* '\''
    ;

Identifier
    : [a-zA-Z_][a-zA-Z0-9_]*
    ;

COMMENT
    : '#' ~[\r\n]* -> skip
    ;

WS: [ \t]+ -> channel(HIDDEN) ;

// Note: Real indentation-sensitive grammar requires custom handling or the Python-style
// INDENT/DEDENT preprocessing used by the ANTLR Python grammar. Here we use placeholders
// to indicate block structure; a later pass should replace them with real handling.
