def show(a, b, c):
    print('a=', a, type(a))
    print('b=', b, type(b))
    print('c=', c, type(c))

GUI {
    # token-style types
    types count:int flag:bool
    addTextField("count")
    addTextField('flag')

    # multi-line dict-style types
    types {
        "x": "int",
        'y': 'float'
    }
    addTextField("x")
    addTextField("y")

    # per-field override
    addTextField("c", "str")

    addButton("Run", show(count, flag, c))
    show()
}
