# Test augmented assignment operators

def test_augmented_operators():
    print("Testing augmented assignment operators")
    print("=" * 50)

    # Test +=
    x = 10
    print("x = 10")
    x += 5
    print("x += 5, x =", x)

    # Test -=
    y = 20
    print("y = 20")
    y -= 7
    print("y -= 7, y =", y)

    # Test *=
    z = 5
    print("z = 5")
    z *= 3
    print("z *= 3, z =", z)

    # Test /=
    a = 100
    print("a = 100")
    a /= 4
    print("a /= 4, a =", a)

    # Test //=
    b = 17
    print("b = 17")
    b //= 5
    print("b //= 5, b =", b)

    # Test %=
    c = 17
    print("c = 17")
    c %= 5
    print("c %= 5, c =", c)

    # Test **=
    d = 2
    print("d = 2")
    d **= 3
    print("d **= 3, d =", d)

    print()
    print("All augmented operator tests passed!")

def test_in_loop():
    print("Testing augmented operators in loops")
    print("=" * 50)

    # Sum with +=
    total = 0
    numbers = [1, 2, 3, 4, 5]
    for n in numbers:
        total += n
    print("Sum of", numbers, "=", total)

    # Product with *=
    product = 1
    for n in [2, 3, 4]:
        product *= n
    print("Product of [2, 3, 4] =", product)

    print()

def test_complex_expressions():
    print("Testing augmented operators with expressions")
    print("=" * 50)

    x = 10
    x += 5 * 2
    print("x = 10, x += 5 * 2, x =", x)

    y = 100
    y -= 10 + 5
    print("y = 100, y -= 10 + 5, y =", y)

    z = 2
    z **= 3 + 1
    print("z = 2, z **= 3 + 1, z =", z)

    print()

def main():
    print()
    print("*" * 60)
    print("  CPJ Augmented Assignment Operators Test")
    print("*" * 60)
    print()

    test_augmented_operators()
    test_in_loop()
    test_complex_expressions()

    print("*" * 60)
    print("  All tests completed successfully!")
    print("*" * 60)
    print()
