# CPJ v5.0 - Final Perfect Standalone Language Test
# This program demonstrates that CPJ is 100% complete!

import Math
import String
import JSON
import System

def test_all_operators():
    print("=" * 60)
    print("Testing All Operators")
    print("=" * 60)

    x = 10
    print("Basic: 10 + 5 =", 10 + 5)
    print("Basic: 10 - 3 =", 10 - 3)
    print("Basic: 10 * 2 =", 10 * 2)
    print("Basic: 10 / 2 =", 10 / 2)
    print("Modulo: 17 % 5 =", 17 % 5)
    print("Power: 2 ** 8 =", 2 ** 8)
    print("Floor div: 17 // 5 =", 17 // 5)

    x += 5
    print("Augmented: x = 10, x += 5, result =", x)
    x *= 2
    print("Augmented: x *= 2, result =", x)
    x //= 3
    print("Augmented: x //= 3, result =", x)

    print()

def test_data_structures():
    print("=" * 60)
    print("Testing Data Structures")
    print("=" * 60)

    numbers = [1, 2, 3, 4, 5]
    print("List:", numbers)
    print("List[0] =", numbers[0])

    squares = [x ** 2 for x in numbers]
    print("Squares:", squares)

    person = {"name": "Alice", "age": 30, "city": "NYC"}
    print("Dict:", person)
    print("person['name'] =", person["name"])

    add = lambda a, b: a + b
    print("Lambda: add(10, 20) =", add(10, 20))

    print()

def test_exceptions():
    print("=" * 60)
    print("Testing Exception Handling")
    print("=" * 60)

    try:
        result = 10 / 2
        print("Success: 10 / 2 =", result)
    except ZeroDivisionError:
        print("Should not happen")
    finally:
        print("Finally block executed")

    try:
        bad = 10 / 0
    except ZeroDivisionError:
        print("Caught division by zero!")

    print()

def test_math_module():
    print("=" * 60)
    print("Testing Math Module")
    print("=" * 60)

    print("Math.PI =", Math.PI)
    print("Math.E =", Math.E)
    print("Math.sqrt(16) =", Math.sqrt(16))
    print("Math.pow(2, 8) =", Math.pow(2, 8))
    print("Math.abs(-42) =", Math.abs(-42))
    print("Math.sin(0) =", Math.sin(0))
    print("Math.cos(0) =", Math.cos(0))
    print("Math.max(5, 10, 3) =", Math.max(5, 10, 3))
    print("Math.min(5, 10, 3) =", Math.min(5, 10, 3))

    print()

def test_string_module():
    print("=" * 60)
    print("Testing String Module")
    print("=" * 60)

    text = "hello world"
    print("Original:", text)
    print("Upper:", String.upper(text))
    print("Title:", String.title(text))
    print("Capitalize:", String.capitalize(text))

    words = String.split(text, " ")
    print("Split:", words)
    joined = String.join("-", words)
    print("Join:", joined)

    print("Contains 'world':", String.contains(text, "world"))
    print("Length:", String.length(text))

    print()

def test_json_module():
    print("=" * 60)
    print("Testing JSON Module")
    print("=" * 60)

    data = {"name": "Bob", "age": 25, "active": 1}
    json_str = JSON.stringify(data)
    print("JSON string:", json_str)

    parsed = JSON.parse(json_str)
    print("Parsed back:", parsed)

    print()

def test_system_module():
    print("=" * 60)
    print("Testing System Module")
    print("=" * 60)

    print("Platform:", System.platform())
    print("Architecture:", System.arch())
    print("Current directory:", System.cwd())
    print("Home directory:", System.home())

    timestamp = System.timestamp()
    print("Timestamp:", timestamp)

    print()

def test_complex_program():
    print("=" * 60)
    print("Testing Complex Program Logic")
    print("=" * 60)

    data = [10, 20, 30, 40, 50]

    total = 0
    for n in data:
        total += n

    mean = total / 5

    results = {
        "data": data,
        "sum": total,
        "mean": mean,
        "count": 5
    }

    print("Data analysis:", results)

    squares = [x ** 2 for x in data]
    print("Squares:", squares)

    calc = lambda x: x * 2 + 10
    transformed = [calc(x) for x in data]
    print("Transformed:", transformed)

    print()

