# CPJ Complete Standard Library Test
# Tests all new features: imports, stdlib modules, augmented operators, with statements

import Math
import String
import JSON
import System
from File import read, write, exists

def test_math_module():
    print("=" * 60)
    print("Testing Math Module")
    print("=" * 60)

    print("Math.PI =", Math.PI)
    print("Math.E =", Math.E)
    print("Math.sqrt(16) =", Math.sqrt(16))
    print("Math.pow(2, 8) =", Math.pow(2, 8))
    print("Math.abs(-42) =", Math.abs(-42))
    print("Math.ceil(3.2) =", Math.ceil(3.2))
    print("Math.floor(3.8) =", Math.floor(3.8))
    print("Math.sin(Math.PI) =", Math.sin(Math.PI))
    print("Math.cos(0) =", Math.cos(0))
    print("Math.max(1, 5, 3) =", Math.max(1, 5, 3))
    print("Math.min(1, 5, 3) =", Math.min(1, 5, 3))
    print()

def test_string_module():
    print("=" * 60)
    print("Testing String Module")
    print("=" * 60)

    text = "hello world"
    print("Original:", text)
    print("Upper:", String.upper(text))
    print("Lower:", String.lower(text))
    print("Title:", String.title(text))
    print("Capitalize:", String.capitalize(text))

    words = String.split(text, " ")
    print("Split:", words)
    print("Join:", String.join("-", words))

    print("Contains 'world':", String.contains(text, "world"))
    print("Starts with 'hello':", String.startswith(text, "hello"))
    print("Length:", String.length(text))
    print()

def test_augmented_operators():
    print("=" * 60)
    print("Testing Augmented Operators")
    print("=" * 60)

    x = 10
    print("x = 10")
    x += 5
    print("x += 5, result:", x)

    y = 20
    y -= 3
    print("y = 20, y -= 3, result:", y)

    z = 5
    z *= 3
    print("z = 5, z *= 3, result:", z)

    a = 100
    a /= 4
    print("a = 100, a /= 4, result:", a)

    b = 2
    b **= 3
    print("b = 2, b **= 3, result:", b)

    c = 17
    c %= 5
    print("c = 17, c %= 5, result:", c)

    print()

def test_json_module():
    print("=" * 60)
    print("Testing JSON Module")
    print("=" * 60)

    data = {"name": "Alice", "age": 30, "city": "NYC"}
    print("Original data:", data)

    json_str = JSON.stringify(data)
    print("JSON string:", json_str)

    parsed = JSON.parse(json_str)
    print("Parsed back:", parsed)

    pretty = JSON.pretty(data)
    print("Pretty JSON:")
    print(pretty)
    print()

def test_system_module():
    print("=" * 60)
    print("Testing System Module")
    print("=" * 60)

    print("Platform:", System.platform())
    print("Architecture:", System.arch())
    print("Current directory:", System.cwd())
    print("Home directory:", System.home())

    args = System.argv()
    print("Command line args:", args)

    timestamp = System.timestamp()
    print("Current timestamp:", timestamp)
    print()

def test_complex_operations():
    print("=" * 60)
    print("Testing Complex Operations")
    print("=" * 60)

    numbers = [1, 2, 3, 4, 5]

    total = 0
    for n in numbers:
        total += n
    print("Sum of", numbers, "=", total)

    squares = [x ** 2 for x in numbers]
    print("Squares:", squares)

    doubled = [n * 2 for n in numbers]
    print("Doubled:", doubled)

    print()

def test_exception_with_stdlib():
    print("=" * 60)
    print("Testing Exceptions with Standard Library")
    print("=" * 60)

    try:
        result = Math.sqrt(16)
        print("sqrt(16) =", result)
    except Exception as e:
        print("Error:", e)

    try:
        bad = Math.sqrt(-1)
        print("This should fail")
    except ValueError as e:
        print("Caught ValueError: negative sqrt")
    except Exception as e:
        print("Caught error:", e)
    finally:
        print("Math operation complete")

    print()

def test_data_processing():
    print("=" * 60)
    print("Testing Data Processing Pipeline")
    print("=" * 60)

    data = [10, 20, 30, 40, 50]

    stats = {
        "count": 0,
        "sum": 0,
        "mean": 0,
        "squares": []
    }

    for value in data:
        stats["count"] += 1
        stats["sum"] += value
        stats["squares"] = stats["squares"] + [value ** 2]

    stats["mean"] = stats["sum"] / stats["count"]

    print("Data:", data)
    print("Statistics:", stats)
    print()

def test_string_operations():
    print("=" * 60)
    print("Testing Advanced String Operations")
    print("=" * 60)

    text = "CPJ Programming Language"

    print("Original:", text)
    print("Length:", String.length(text))
    print("Upper:", String.upper(text))
    print("Lower:", String.lower(text))

    words = String.split(text, " ")
    print("Words:", words)
    print("Word count:", String.length(words))

    reversed_text = String.reverse(text)
    print("Reversed:", reversed_text)

    repeated = String.repeat("CPJ ", 3)
    print("Repeated:", repeated)

    print()

def test_calculator_with_stdlib():
    print("=" * 60)
    print("Testing Calculator with Standard Library")
    print("=" * 60)

    print("Basic operations:")
    print("2 + 3 =", 2 + 3)
    print("10 - 4 =", 10 - 4)
    print("5 * 6 =", 5 * 6)
    print("20 / 4 =", 20 / 4)
    print("17 % 5 =", 17 % 5)
    print("2 ** 8 =", 2 ** 8)
    print("17 // 5 =", 17 // 5)

    print()
    print("Advanced math:")
    print("sqrt(144) =", Math.sqrt(144))
    print("pow(3, 4) =", Math.pow(3, 4))
    print("abs(-99) =", Math.abs(-99))
    print("max(5, 10, 3, 8) =", Math.max(5, 10, 3, 8))
    print("min(5, 10, 3, 8) =", Math.min(5, 10, 3, 8))

    print()

def main():
    print()
    print("*" * 70)
    print("*" + " " * 68 + "*")
    print("*" + "  CPJ v5.0 - COMPLETE STANDALONE LANGUAGE TEST".center(68) + "*")
    print("*" + "  All Standard Library Modules".center(68) + "*")
    print("*" + " " * 68 + "*")
