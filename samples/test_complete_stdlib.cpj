    test_calculator_with_stdlib()

    print("*" * 70)
    print("*" + " " * 68 + "*")
    print("*" + "  ALL TESTS COMPLETED SUCCESSFULLY!".center(68) + "*")
    print("*" + " " * 68 + "*")
    print("*" * 70)
    print()
    print("Features Tested:")
    print("  ✓ Math module (sqrt, pow, trig, etc.)")
